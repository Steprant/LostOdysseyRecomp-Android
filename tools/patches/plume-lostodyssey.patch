+        const int64_t bottom = std::max(int64_t(a.offset.y) + a.extent.height, int64_t(b.offset.y) + b.extent.height);
+        return VkRect2D{ VkOffset2D{ left, top }, VkExtent2D{ uint32_t(right - left), uint32_t(bottom - top) } };
+    }
