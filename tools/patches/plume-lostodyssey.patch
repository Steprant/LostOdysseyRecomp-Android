+            fb->renderAreaGranularity.height = std::max(fb->renderAreaGranularity.height, 1u);
+        }
+        const int64_t gw = fb->renderAreaGranularity.width, gh = fb->renderAreaGranularity.height;
+        int64_t left = std::clamp<int64_t>(rect.offset.x, 0, fb->width), top = std::clamp<int64_t>(rect.offset.y, 0, fb->height);
+        int64_t right = std::clamp<int64_t>(int64_t(rect.offset.x) + rect.extent.width, 0, fb->width);
+        int64_t bottom = std::clamp<int64_t>(int64_t(rect.offset.y) + rect.extent.height, 0, fb->height);
+        left = left / gw * gw; top = top / gh * gh;
+        right = std::min<int64_t>((right + gw - 1) / gw * gw, fb->width);
+        bottom = std::min<int64_t>((bottom + gh - 1) / gh * gh, fb->height);
