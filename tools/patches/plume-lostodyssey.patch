+        switch (bucket) {
+        case RenderPassProfile::FlowBucket::Read: profile.flow.storeRead[k] += census.pendingStore; break;
+        case RenderPassProfile::FlowBucket::Loaded: profile.flow.storeLoaded[k] += census.pendingStore; break;
