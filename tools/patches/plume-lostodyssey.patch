+            return VkRect2D{ VkOffset2D{ 0, 0 }, VkExtent2D{ fb->width, fb->height } };
+        }
+        return VkRect2D{ VkOffset2D{ int32_t(left), int32_t(top) }, VkExtent2D{ uint32_t(right - left), uint32_t(bottom - top) } };
+    }
