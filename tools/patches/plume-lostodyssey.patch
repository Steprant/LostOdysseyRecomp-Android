+    void VulkanCommandList::prepareClearRenderArea(const RenderRect *clearRects, uint32_t clearRectsCount) {
+        if ((clearRects == nullptr) || (clearRectsCount == 0)) {
+            prepareRenderArea(nullptr);
+            return;
+        }
+        VkRect2D area = {};
+        for (uint32_t i = 0; i < clearRectsCount; i++) {
+            const RenderRect &r = clearRects[i];
+            const VkRect2D rect = { VkOffset2D{ r.left, r.top }, VkExtent2D{ uint32_t(std::max(r.right - r.left, 0)), uint32_t(std::max(r.bottom - r.top, 0)) } };
