+            if (first >= ticks.size() || last >= ticks.size() || ticks[last] < ticks[first]) return 0;
+            return uint64_t(double(ticks[last] - ticks[first]) * period);
+        };
+        for (const ProfiledPass &pass : profiledPasses) {
+            RenderPassProfile::Pass info = pass.info;
+            if (timed && pass.beginQuery != ~0u && pass.endQuery != ~0u) info.gpuNs = ns(pass.beginQuery, pass.endQuery);
