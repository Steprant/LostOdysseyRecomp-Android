+    RenderDisplayState D3D12SwapChain::getDisplayState() const {
+        RenderDisplayState state;
+        if (d3d == nullptr || desc.outputMode != RenderOutputMode::HDR_LINEAR ||
+            desc.format != RenderFormat::R16G16B16A16_FLOAT) return state;
+
+        // The FP16 buffer remains scRGB when Windows HDR is turned off or the
+        // window moves to an SDR display. The caller can then render 0..1.
+        state.encoding = RenderOutputEncoding::SCRGB;
+        state.linearUnitNits = 80.0f;
+
+        UINT colorSpaceSupport = 0;
+        if (!scRGBColorSpaceSet ||
+            FAILED(d3d->CheckColorSpaceSupport(DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709, &colorSpaceSupport)) ||
+            (colorSpaceSupport & DXGI_SWAP_CHAIN_COLOR_SPACE_SUPPORT_FLAG_PRESENT) == 0) return state;
+
+        const WindowPixelContext pixels;
+        RECT windowBounds = {};
+        if (!pixels.ready() || !GetWindowRect(desc.renderWindow, &windowBounds)) return state;
+
+        // DXGI's GetContainingOutput can be stale after the monitor topology
+        // changes. Refresh the factory and choose the output with the largest
+        // intersection with the actual window, including after a screen move.
+        std::lock_guard lock(displayFactoryMutex);
+        if (displayFactory == nullptr || !displayFactory->IsCurrent()) {
+            if (displayFactory != nullptr) displayFactory->Release();
+            displayFactory = nullptr;
+            if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&displayFactory)))) return state;
+        }
+
+        DXGI_OUTPUT_DESC1 outputDesc = {};
+        int64_t largestArea = 0;
+        for (UINT adapterIndex = 0; ; ++adapterIndex) {
+            IDXGIAdapter1 *adapter = nullptr;
+            if (displayFactory->EnumAdapters1(adapterIndex, &adapter) == DXGI_ERROR_NOT_FOUND) break;
+            if (adapter == nullptr) break;
+            for (UINT outputIndex = 0; ; ++outputIndex) {
+                IDXGIOutput *output = nullptr;
+                if (adapter->EnumOutputs(outputIndex, &output) == DXGI_ERROR_NOT_FOUND) break;
+                if (output == nullptr) break;
+                IDXGIOutput6 *output6 = nullptr;
+                if (SUCCEEDED(output->QueryInterface(IID_PPV_ARGS(&output6)))) {
+                    DXGI_OUTPUT_DESC1 candidate = {};
+                    if (SUCCEEDED(output6->GetDesc1(&candidate))) {
+                        const RECT &screen = candidate.DesktopCoordinates;
+                        const int64_t w = std::max<LONG>(0, std::min(windowBounds.right, screen.right) - std::max(windowBounds.left, screen.left));
+                        const int64_t h = std::max<LONG>(0, std::min(windowBounds.bottom, screen.bottom) - std::max(windowBounds.top, screen.top));
+                        if (w * h > largestArea) {
+                            largestArea = w * h;
+                            outputDesc = candidate;
+                        }
+                    }
+                    output6->Release();
+                }
+                output->Release();
+            }
+            adapter->Release();
+        }
+        if (largestArea == 0) return state;
+
+        // DXGI exposes the currently active HDR mode. It cannot identify a
+        // display whose HDR capability exists but is disabled in Windows.
+        state.hdrSupported = outputDesc.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+        state.hdrActive = state.hdrSupported && scRGBColorSpaceSet;
+        if (state.hdrActive) {
+            state.peakNits = outputDesc.MaxLuminance;
+            state.headroom = std::max(1.0f, state.peakNits / state.linearUnitNits);
+        }
+        return state;
+    }
