+    // The rectangle clipped to the framebuffer and widened to the render
+    // pass's granularity (which only affects speed, never correctness).
+    static VkRect2D fitRenderArea(const VulkanFramebuffer *fb, VkDevice device, VkRect2D rect) {
+        if (fb->renderAreaGranularity.width == 0) {
+            vkGetRenderAreaGranularity(device, fb->renderPass, &fb->renderAreaGranularity);
