+    VkRect2D VulkanCommandList::frameGraphRenderArea(VkRect2D area) const {
+        const FrameGraph &g = *frameGraph;
+        const VulkanFramebuffer *fb = targetFramebuffer;
+        const VkRect2D full = { VkOffset2D{ 0, 0 }, VkExtent2D{ fb->width, fb->height } };
+        const VkDevice device = queue->device->vk;
+        using Op = FrameGraph::Op;
+        VkRect2D scissor = activeScissor;
+        bool scissorValid = activeScissorValid;
+        const size_t end = g.segmentEnd[g.cursor];
+        for (size_t i = g.cursor + 1; i < end; i++) {
+            const FrameGraph::Cmd &c = g.cmds[i];
+            if (FrameGraph::isEnder(c.op)) break;
+            switch (c.op) {
+            case Op::SetScissors:
+                if (c.count == 1) {
+                    const RenderRect &r = *g.load<RenderRect>(c.data, 1);
+                    scissor = VkRect2D{ VkOffset2D{ r.left, r.top }, VkExtent2D{ uint32_t(r.right - r.left), uint32_t(r.bottom - r.top) } };
+                    scissorValid = true;
+                }
+                else scissorValid = false;
+                break;
+            case Op::DrawInstanced: case Op::DrawIndexed: case Op::BeginOcclusion:
+                if (!scissorValid) return full;
+                area = rectUnion(area, fitRenderArea(fb, device, scissor));
+                break;
+            case Op::ClearColor: case Op::ClearDepthStencil: {
+                if (c.count == 0) return full;
+                const RenderRect *rects = g.load<RenderRect>(c.data, c.count);
+                for (uint32_t r = 0; r < c.count; r++) {
+                    const VkRect2D rect = { VkOffset2D{ rects[r].left, rects[r].top },
+                        VkExtent2D{ uint32_t(std::max(rects[r].right - rects[r].left, 0)), uint32_t(std::max(rects[r].bottom - rects[r].top, 0)) } };
+                    area = rectUnion(area, fitRenderArea(fb, device, rect));
+                }
+                break;
+            }
+            default:
+                break;
+            }
+        }
+        return area;
+    }
