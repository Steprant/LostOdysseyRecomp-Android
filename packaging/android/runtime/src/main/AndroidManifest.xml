<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Startup download of the precompiled shader pack and of GPU driver packages. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional custom game folder: the runtime opens game files by path, so a
         folder outside Android/data needs All files access (Android 11+) or the
         storage permission (Android 8-10). The app folder needs neither. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Steprant 2.1.1: GameKeepAliveService, foreground priority while the game runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <application android:label="${loAppLabel}"
        android:icon="${loAppIcon}"
        android:roundIcon="${loAppIcon}"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true">
        <!-- Launcher: the GPU driver page on Qualcomm and Mali devices, then the game (or the game folder page without game data). -->
        <activity android:name=".GpuDriverActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GameFolderActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation" />
        <activity android:name=".SaveTransferActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation" />
        <!-- Exported so `adb shell am start -n …/.RuntimeActivity` still skips the driver page. -->
        <activity android:name=".RuntimeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LostOdyssey.Game"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <!-- Steprant 2.1.1: holds the ongoing notification that keeps a running
             game from being reclaimed in the background; it does no work. -->
        <service android:name=".GameKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a running game session's state in memory while the player switches apps" />
        </service>
    </application>
</manifest>
